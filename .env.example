# Copy this file to .env and replace the placeholder values.
# .env is git-ignored: real passwords and keys must NEVER be committed.

# Image tag. Jenkins sets this to the build number automatically.
TAG=latest
GIT_COMMIT=local

# Port on your computer where the app is served (http://localhost:8080)
PROXY_PORT=8080

# Database
POSTGRES_DB=pasalamat
POSTGRES_USER=pasalamat
POSTGRES_PASSWORD=change-me

# Release Studio login
STUDIO_PASSWORD=change-me
STUDIO_SECRET=change-me-to-a-long-random-string

# GitHub (classic token with only the public_repo scope)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=anferlleesugay/pasalamat-wall
GITHUB_BRANCH=main

# Gemini AI (leave empty to run without AI; the app falls back automatically)
GEMINI_API_KEY=
WORKER_GEMINI_MODEL=gemini-3.8-flash
STUDIO_GEMINI_MODEL=gemini-3.5-flash-lite
